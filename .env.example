# ============================================================================
# 07PREPORT — ENVIRONMENT CONFIGURATION TEMPLATE (repo-wide overview)
# ============================================================================
# This root file is a reference index only. The two files that are actually
# read by the running application are:
#
#   07ps-sales-dashboard-app/backend/.env        (web app: API, auth, ETL orchestration)
#   07ps-sales-dashboard-app/data/ingestion/.env  (legacy/CI ingestion service)
#
# Copy each ".env.example" next to it to ".env" and fill in real values.
# NEVER commit a real .env file — every ".env" (any folder) is git-ignored.
# The values below mirror backend/.env.example so you can see the full set
# of variables the app needs without hunting through the tree.
# ============================================================================

# ----------------------------------------------------------------------------
# Backend server
# ----------------------------------------------------------------------------
PORT=4000
FRONTEND_ORIGIN=http://localhost:3000

# ----------------------------------------------------------------------------
# Database — MySQL 8 (see docs/tech-stack-decision.md for why MySQL, not Postgres)
# ----------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_USER=ps_app
DB_PASSWORD=changeme
DB_NAME=ps_warehouse
DB_SOCKET=

# ----------------------------------------------------------------------------
# Auth / JWT
# ----------------------------------------------------------------------------
JWT_SECRET=change-this-in-every-environment

# ----------------------------------------------------------------------------
# SMTP (forgot/reset password emails)
# ----------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="07PREPORT <no-reply@example.com>"

# ----------------------------------------------------------------------------
# Login rate limiting / account lockout
# ----------------------------------------------------------------------------
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_LOGIN_WINDOW_MIN=15
ACCOUNT_LOCK_THRESHOLD=5
PASSWORD_RESET_TOKEN_TTL_MIN=60

# ----------------------------------------------------------------------------
# Odoo ERP connection (used by the vendored ETL pipeline in data/etl)
# ----------------------------------------------------------------------------
ODOO_URL=https://your-instance.odoo.com
ODOO_DB=your_odoo_database
ODOO_USER=your_odoo_user@example.com
ODOO_API_KEY=your_odoo_api_key_here
ODOO_TIMEOUT_SECONDS=60
ODOO_MAX_RETRIES=5

# ----------------------------------------------------------------------------
# ETL (see docs/ETL_WORKFLOW.md and data/etl/docs/)
# ----------------------------------------------------------------------------
ETL_BATCH_SIZE=500
ETL_DB_CHUNKSIZE=5000
ETL_PYTHON_BIN=python
ETL_PYTHON_DIR=../data/etl
ETL_INPUT_DIR=../data/etl/Input
ETL_OUTPUT_DIR=../data/etl/Exports
ETL_LOG_DIR=./logs/etl
ETL_SCHEDULE_INCREMENTAL_CRON=50 8,11,14,17,20 * * *
ETL_SCHEDULE_INCREMENTAL_ENABLED=true
ETL_SCHEDULE_FULL_CRON=0 2 * * *
ETL_SCHEDULE_FULL_ENABLED=true

# ----------------------------------------------------------------------------
# Redis (BullMQ ETL job queue — only needed for etl:worker / non---sync ETL runs)
# ----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379

# ============================================================================
# NOTES
# ============================================================================
# 1. Full, authoritative variable docs live in:
#    07ps-sales-dashboard-app/backend/.env.example (comments explain every field)
#    07ps-sales-dashboard-app/data/ingestion/.env.example
# 2. Never commit a real .env. Rotate any credential that was ever pasted into
#    a chat, ticket, or now-archived doc under docs/archive/.
# 3. See docs/ARCHITECTURE.md and docs/DEPLOYMENT.md for how these variables
#    map onto the running services.
# ============================================================================
