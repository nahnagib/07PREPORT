# Backend service configuration - copy to .env and fill in per environment.
PORT=4000
# development | production. In production the API exits at startup if the database is unreachable.
NODE_ENV=development
# Single business/display timezone (IANA). It is the zone the naive Fact_* order timestamps are stored
# in (must equal the ETL's TIMEZONE) and the zone shown to users. Operational timestamps are UTC.
APP_TIMEZONE=Africa/Tripoli
# Refresh-log consistency check (docs/ETL.md section 9): minutes of skew tolerated between the last
# refresh and the newest loaded order, and after how many minutes without a successful run the data
# is called stale.
REFRESH_CHECK_TOLERANCE_MINUTES=5
REFRESH_STALE_AFTER_MINUTES=270
# MySQL 8 connection (replaces the previous Postgres DATABASE_URL -- see docs/tech-stack-decision.md
# and src/db/pool.ts's header). Use DB_SOCKET for a local unix socket connection, or
# DB_HOST/DB_PORT for TCP; DB_SOCKET takes precedence if set.
DB_HOST=localhost
DB_PORT=3306
DB_USER=ps_app
DB_PASSWORD=changeme
DB_NAME=ps_warehouse
DB_SOCKET=
JWT_SECRET=change-this-in-every-environment
# CORS origin for the Next.js frontend; also used to build password-reset links in emails.
FRONTEND_ORIGIN=http://localhost:3000
# Public URL of the web app incl. the /Dashboard base path, used for links printed outside the app
# (the Kaizen Board QR code). Optional: defaults to the first FRONTEND_ORIGIN entry + /Dashboard.
# Production example: PUBLIC_APP_URL=https://bmh.com.ly/Dashboard
PUBLIC_APP_URL=

# --- Auth module (Excel import, forgot/reset password, login rate limiting) ---
# Generic SMTP (nodemailer) - used for temp-password and password-reset emails.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="BMH Sales Dashboard <no-reply@example.com>"
# Login endpoint rate limiting (express-rate-limit), per source IP.
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_LOGIN_WINDOW_MIN=15
# Consecutive failed-password attempts before an account is auto-locked (status=LOCKED).
ACCOUNT_LOCK_THRESHOLD=5
# How long a forgot-password reset link/token stays valid.
PASSWORD_RESET_TOKEN_TTL_MIN=60

# --- ETL module (backend/src/etl -- orchestrates the vendored Odoo pipeline in data/etl) ---
# pythonRunner.ts no longer spawns `python -m sales_pipeline.main` directly -- cPanel shared
# hosting can't run this API process's own Python subprocesses reliably, so that moved into a
# separate Flask API (data/etl/api/app.py) that this process calls over HTTP. Odoo credentials and
# pipeline tuning knobs (ODOO_*, ETL_BATCH_SIZE, ETL_PYTHON_BIN/DIR, etc.) now live only in that
# Flask API's own environment (see data/etl/api/.env.example) -- this process needs just the two
# vars below to reach it.
ETL_API_URL=http://localhost:5001
ETL_API_KEY=
# Generate with: openssl rand -base64 32 -- must match data/etl/api's ETL_API_KEY exactly.
ETL_API_POLL_INTERVAL_MS=1000
ETL_LOG_DIR=./logs/etl
# Cron schedules (node-cron), each independently configurable and disable-able.
# Server-only switches (default false). Only the production server sets these to true. Keep false on a laptop / test copy: the app then never starts an ETL job by itself (docs/etl-refresh-schedule.md).
ETL_SCHEDULER_ENABLED=false
ETL_WORKER_ENABLED=false
# A laptop / test copy that runs the production build (Docker, NODE_ENV=production) sets this, so the
# "No ETL schedule is running on this server" alarm stays off. NEVER on the server.
ETL_SCHEDULER_OFF_OK=true
# 30-minute refresh (job refresh_30m): shared lists -> receivables + collections -> NPS, each module isolated. The
# modules are ETL_REFRESH_MODULES in data/etl/.env. Interval = a divisor of 60 (default 30), or an explicit cron in
# ETL_SCHEDULE_REFRESH_CRON. A tick in the same minute as the full or sales run yields to it.
ETL_SCHEDULE_REFRESH_ENABLED=true
ETL_REFRESH_INTERVAL_MINUTES=30
# Sales (job main = core dims -> sales): keeps its own slots until its write_date incremental is built (Phase B).
ETL_SCHEDULE_INCREMENTAL_CRON=50 8,11,14,17,20 * * *
ETL_SCHEDULE_INCREMENTAL_ENABLED=true
# Full refresh (full_all = core dims -> receivables -> sales full rebuild), unchanged.
ETL_SCHEDULE_FULL_CRON=0 2 * * *
ETL_SCHEDULE_FULL_ENABLED=true
# The old 15:00 receivables run (finance_receivables alone): off, the 30-minute refresh covers it. Rollback = true.
ETL_SCHEDULE_FINANCE_CRON=0 15 * * *
ETL_SCHEDULE_FINANCE_ENABLED=false
# The NPS Score's own nightly schedule (full reload). While the full schedule above is on, NPS is the last step of that
# 02:00 full_all and this own schedule is NOT registered (never twice a night). Only with ETL_SCHEDULE_FULL_ENABLED=false
# does process_nps run alone at this cron. The 30-minute refresh also runs process_nps (ETL's ETL_REFRESH_MODULES).
# Set true together with the ETL's NPS_ENABLED.
ETL_SCHEDULE_PROCESS_NPS_CRON=0 2 * * *
ETL_SCHEDULE_PROCESS_NPS_ENABLED=true
# NPS/CSAT values with fewer responders are faded and labeled n = x (zero responders shows no score).
NPS_MIN_RESPONDERS=5
# IANA zone the three cron expressions above are read in. Unset = APP_TIMEZONE (default Africa/Tripoli).
ETL_SCHEDULE_TIMEZONE=Africa/Tripoli
# Redis (BullMQ job queue -- Laravel-Queues-equivalent). The API process only enqueues jobs; only
# the etl:worker process needs Python installed to actually execute them.
# Local dev (Redis on your machine): localhost. Under docker-compose: use the service name "redis"
# (see docker-compose.yml's `redis` service) -- container-to-container DNS, not localhost.
REDIS_HOST=localhost
REDIS_PORT=6379
