# The BullMQ worker that processes queued ETL jobs (runPipelineJob.ts). No longer needs Python or
# data/etl at all: pythonRunner.ts calls the ETL Flask API (data/etl/api/, its own container built
# from data/etl/Dockerfile.api) over HTTP instead of spawning `python -m sales_pipeline.main`
# itself - that subprocess now lives entirely inside the etl-api container. This image is Node-only
# again, same as backend/Dockerfile.
# Build context is the repo root (same convention as backend/Dockerfile and frontend/Dockerfile).
FROM node:20-alpine
WORKDIR /repo
COPY package.json ./
COPY backend ./backend
RUN npm install --workspace backend --omit=dev
WORKDIR /repo/backend
RUN npm run build
CMD ["node", "dist/etl/commands/worker.js"]
