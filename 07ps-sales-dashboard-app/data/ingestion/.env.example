# Ingestion service configuration. Copy to .env and fill in per environment.

# MySQL 8 connection (replaces the original Postgres DATABASE_URL -- see
# docs/tech-stack-decision.md's 2026-07-05 correction). Same variables as backend/.env.example
# since orchestrator.py and load_real_export.py connect with pymysql the same way the backend does.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=ps_warehouse
DB_SOCKET=

# Odoo is mocked by default (see odoo/mock_client.py) -- no real credentials needed to run the
# pipeline locally. Setting ALLOW_LIVE_ODOO=1 switches to the real vendored OdooClient, which then
# requires these. Leave ALLOW_LIVE_ODOO unset/0 for local/dev use.
ALLOW_LIVE_ODOO=0
ODOO_URL=https://odoo.example.internal
ODOO_DB=bmh_production
ODOO_USERNAME=
ODOO_API_KEY=

# Local folder containing the manual Input Excel workbooks (SalesTeam.xlsx, sales_targets.xlsx,
# PRODUCTS.xlsx, OffDays.xlsx, BlockedCustomers.xlsx) -- required, no Windows-path fallback.
# See README.md "Path portability" for why this is a synced local folder, not a Drive API call.
INPUT_DIR=/path/to/Input

# ETL Flask API (app.py/wsgi.py) -- the api-etl.<domain> side of the split cPanel deployment.
# Bearer token the Node backend must send in `Authorization: Bearer <key>` to POST /etl/run or
# /etl/load-export (GET /health is unauthenticated). Generate with: openssl rand -base64 32
ETL_API_KEY=
LOG_LEVEL=INFO
# Local-dev only; cPanel's Python app config sets the listen port itself.
PORT=5000
