# DEPRECATED 2026-07-05: superseded by orchestrator.py + scheduler_new.py (reuses this same APScheduler scaffold/cadence, wired to the real extraction+transform+star-schema-load pipeline instead of the placeholder odoo_connector/excel_ingest calls).
#
# This file was written in the Phase P1 bootstrap session, before the existing
# powerbi_sales_pipeline codebase (the pipeline that actually produces SalesModel_OneOutput.xlsx)
# had been read. It designed its own Odoo/Excel extraction logic and Postgres schema from
# scratch/blind, which the ingestion-layer session (see ../README.md) found does not match the
# real pipeline's proven business rules, the real Input-folder file schemas, or the MySQL 8
# warehouse this app now targets. Left in git history for traceability; not imported by anything
# and not maintained. See ../README.md for the current, validated implementation.

"""5x-daily refresh scheduler - Standards Section 2.1.2/5.14: "A scheduled (non-real-time)
refresh five times per day: 9:00 AM, 12:00 PM, 3:00 PM, 6:00 PM, 9:00 PM, with tolerance of up
to 30 minutes." Explicitly NOT real-time (Section 8.2) - this process is a long-running worker,
not a request-triggered job, so the web app never triggers a refresh on page load.
"""

from __future__ import annotations

import logging
from datetime import date, datetime, timedelta

from apscheduler.schedulers.blocking import BlockingScheduler
from apscheduler.triggers.cron import CronTrigger

from config import CONFIG
from db import RefreshRun, get_connection
from excel_ingest import load_all_targets
from odoo_connector import OdooConnectionError, run_incremental_sales_pull

logging.basicConfig(level=logging.INFO, format="%(asctime)s %(levelname)s %(name)s: %(message)s")
logger = logging.getLogger(__name__)


def run_odoo_refresh() -> None:
    with get_connection() as conn:
        with RefreshRun(conn, source="odoo") as run:
            try:
                rows = run_incremental_sales_pull(since=date.today() - timedelta(days=1))
                run.row_count = len(rows)
                # TODO (Phase P1): map Odoo sale.order.line rows -> fact_sales / fact_invoice_line
                # inserts here once the exact Odoo field mapping is confirmed in Phase P0 sign-off.
                logger.info("Pulled %d sale.order.line rows from Odoo", len(rows))
            except OdooConnectionError as e:
                # Standards Section 9 risk register: "Data access delays -> dashboards show
                # stale data." Fail the run loudly into refresh_log; do not fabricate data.
                logger.error("Odoo refresh failed: %s", e)
                raise


def run_excel_target_refresh() -> None:
    with get_connection() as conn:
        with RefreshRun(conn, source="excel_targets") as run:
            df = load_all_targets()
            run.row_count = len(df)
            # TODO (Phase P1): upsert df into fact_target_plan + call excel_ingest.reconcile()
            # against the existing warehouse rows before treating this run as trustworthy.
            logger.info("Loaded %d target rows from Excel", len(df))


def run_all() -> None:
    logger.info("Starting scheduled refresh at %s", datetime.now().isoformat())
    run_odoo_refresh()
    run_excel_target_refresh()


def main() -> None:
    scheduler = BlockingScheduler()
    for t in CONFIG.refresh_times:
        hour, minute = t.split(":")
        scheduler.add_job(run_all, CronTrigger(hour=hour, minute=minute), name=f"refresh-{t}")
    logger.info("Scheduler started - refresh times: %s", CONFIG.refresh_times)
    scheduler.start()


if __name__ == "__main__":
    main()
