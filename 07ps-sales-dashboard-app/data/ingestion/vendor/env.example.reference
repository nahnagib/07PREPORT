# ================================
# ODOO CONNECTION
# ================================
ODOO_URL=https://your-instance.odoo.com
ODOO_DB=your_odoo_database
ODOO_USER=your_odoo_user@example.com
ODOO_API_KEY=your_api_key_here

# ================================
# LOCAL FILE PATHS
# ================================
INPUT_DIR=/path/to/Input
OUTPUT_DIR=/path/to/Exports
OUTPUT_FILE=SalesModel_OneOutput.xlsx
INVENTORY_VALIDATION_FILE=Inventory_Validation.xlsx
UNMAPPED_PRODUCTS_FILE=Unmapped_Products.xlsx

# ================================
# PIPELINE SETTINGS
# ================================
BATCH_SIZE=500
TIMEZONE=Africa/Tripoli
ASSUME_UTC_FOR_NAIVE=false

# CRM LOGIC
CRM_INACTIVE_DAYS_THRESHOLD=30
CRM_RECENT_ACTIVITY_DAYS=14

# ================================
# DATABASE (MYSQL)
# ================================
DB_TYPE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=powerbi_sales
DB_USER=powerbi_user
DB_PASSWORD=changeme
DB_SCHEMA=
DB_RELOAD_MODE=drop_recreate
DB_CHUNKSIZE=1000
INCREMENTAL_OVERLAP_DAYS=7
INCLUDE_UNINVOICED_SALES_LINES=false
FORCE_SALES_FULL_REFRESH=false

# ================================
# OPTIONAL: SINGLE CONNECTION STRING (SAFE)
# ================================
DB_URL=
# Example:
# DB_URL=mysql+pymysql://DB_USER:DB_PASSWORD@DB_HOST:3306/DB_NAME?charset=utf8mb4
