# Env file for the containerized ETL Flask API (data/etl/api/, built via data/etl/Dockerfile.api).
# docker-compose.yml loads this via `env_file: ./data/etl/.env` -- Docker injects these as real
# environment variables into the etl-api container, which the Flask process (api_config.py) reads
# directly, and which the pipeline subprocess it spawns (data/etl/src/sales_pipeline/main.py, via
# config/settings.py's Settings.from_env()) inherits in turn. Copy to .env and fill in for local
# `docker compose up`; on the VPS these same values go in the real data/etl/.env deployed there.

# --- MySQL (same production instance the backend/data/ingestion services use) ---
# DB_USER/DB_NAME left blank deliberately (not "ps_warehouse_user"/"ps_warehouse" -- those looked
# like real values but pointed at a user/database that doesn't exist, which is exactly what let
# this go unnoticed: Odoo creds are obviously blank, but a wrong-looking-plausible DB_USER/DB_NAME
# isn't). Copy the real values from backend/.env's DB_USER/DB_NAME -- same MySQL instance, reused
# as-is, per docs/etl-deployment.md.
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# --- Odoo (real pipeline, not mocked -- see data/etl/README.md) ---
ODOO_URL=https://your-instance.odoo.com
ODOO_DB=
ODOO_USER=
ODOO_API_KEY=
ODOO_TIMEOUT_SECONDS=60
ODOO_MAX_RETRIES=5
# Run start: retry network/DNS failures reaching Odoo with exponential backoff (5s, 10s, ... capped at 120s)
# for up to this many seconds before the run fails. 0 = only ODOO_MAX_RETRIES quick attempts.
ODOO_CONNECT_RETRY_WINDOW_SECONDS=900

# --- ETL platform (python -m etl_platform.run; docs/ETL.md) ---
# Production guard: the platform refuses to run unless ODOO_DB == ODOO_PROD_DB AND the host of ODOO_URL is
# listed here. Odoo.sh serves the production database under a *.dev.odoo.com name too, so list both if used.
# ALLOW_NON_PROD=1 disables the guard (never in production).
ODOO_PROD_DB=
ODOO_ALLOWED_HOSTS=
ALLOW_NON_PROD=0
ODOO_COMPANY_IDS=1,3
# Optional: extra in-scope companies by Odoo display name; resolved to ids at runtime.
ODOO_COMPANY_NAMES=Athena
# Optional expiry date (YYYY-MM-DD) of ODOO_API_KEY: the run warns 14 days before (ETL_KEY_EXPIRY_WARN_DAYS).
ODOO_KEY_EXPIRES=
# Finance (receivables) uses its own read-only bot user: ODOO_<PROFILE>_LOGIN / _API_KEY / _KEY_EXPIRES.
ODOO_DEBT_LOGIN=
ODOO_DEBT_API_KEY=
ODOO_DEBT_KEY_EXPIRES=

# Finance: Odoo partner ids whose receivables are inter-company balances although they are not our own companies'
# partners (decision A1, 2026-10-04): 15907 "مديونية شركة تيكا" (on Majaal's books), 15905 "مديونية مجال" (on Tika's).
# They are flagged is_intercompany and left out of the Debt page's default view. Empty = only the companies' own partners.
FINANCE_INTERCOMPANY_PARTNER_IDS=15905,15907
ETL_ODOO_MAX_RETRIES=3
ETL_ODOO_PAGE_SIZE=2000
ETL_ODOO_ID_CHUNK_SIZE=500
ETL_INCREMENTAL_OVERLAP_SECONDS=300
ETL_KEY_EXPIRY_WARN_DAYS=14
# A department job reuses core_dims when it succeeded within this many minutes.
ETL_CORE_DIMS_FRESH_MINUTES=180

# --- Timezones (see docs/ETL.md section 8) ---
# TIMEZONE = the BUSINESS zone: Odoo's UTC timestamps are converted to it before landing in the
# Fact_* tables (OrderDateTime, QuotationDate, ...). It MUST equal the backend's APP_TIMEZONE -- the
# dashboard flags a mismatch. Under docker-compose it is set for you from APP_TIMEZONE.
# config/settings.py defaults to Africa/Tripoli if unset -- set explicitly anyway.
TIMEZONE=Africa/Tripoli
# Session time_zone for every MySQL connection the pipeline opens (CURRENT_TIMESTAMP, TIMESTAMP
# columns). Keep +00:00: operational timestamps (etl_run_log.*_utc) are UTC.
DB_SESSION_TIMEZONE=+00:00
# Also set TZ (container/OS zone, log readability only) -- docker-compose.yml does this from APP_TIMEZONE.
# TZ=Africa/Tripoli

# --- Manual input Excel workbooks the pipeline validates against every run ---
# Where the workbooks live, AS SEEN BY THE PROCESS THAT RUNS THE PIPELINE. Relative values resolve
# against data/etl/. Default if unset: data/etl/input. A Windows path (C:/...) is only valid when the
# pipeline runs natively on Windows -- in Docker/Linux it fails fast with an explanation.
# Under docker-compose you do NOT set these here: docker-compose.yml mounts ETL_INPUT_HOST_DIR
# (project .env) at /etl/input and sets ETL_INPUT_DIR for you.
# ETL_INPUT_DIR=./input
# ETL_OUTPUT_DIR=./Exports   # must be writable
# Where the previous version of an input workbook is copied when an admin replaces it from the ETL
# Control Center (api/input_files.py). Default: data/etl/input_backups. Must not be inside ETL_INPUT_DIR.
# Under docker-compose it is set for you (/etl/input_backups).
# ETL_INPUT_BACKUP_DIR=./input_backups

# --- ETL Flask API (data/etl/api/) ---
# Bearer token backend/.env's ETL_API_KEY must match exactly.
ETL_API_KEY=
# Generate with: openssl rand -base64 32
LOG_LEVEL=INFO
FLASK_ENV=production
# PYTHON_BIN is left unset in Docker -- the image installs the pipeline into its own system
# Python (see Dockerfile.api), so api_config.py's default (sys.executable) is already correct.
PYTHON_BIN=

# --- Pipeline tuning / safety (all optional; defaults shown) ---
# Rows per Odoo RPC batch, and DB insert chunk size.
# BATCH_SIZE=500
# DB_CHUNKSIZE=5000
# Incremental runs re-read this many days before the latest loaded order (minimum enforced: 7).
# INCREMENTAL_OVERLAP_DAYS=7
# drop_recreate (default, rebuilds tables on a full run) | truncate
# DB_RELOAD_MODE=drop_recreate
# Treat naive Odoo timestamps as UTC. Leave false unless Odoo returns naive UTC values.
# ASSUME_UTC_FOR_NAIVE=false
# Fully reload raw sale.order/sale.order.line on every run (slow; use --force-sales-full-refresh for one-offs).
# FORCE_SALES_FULL_REFRESH=false
# INCLUDE_UNINVOICED_SALES_LINES=false
# CRM_INACTIVE_DAYS_THRESHOLD=30
# CRM_RECENT_ACTIVITY_DAYS=14
# A PRODUCTS.xlsx that yields 0 name mappings FAILS the run by default. Set true only for a brand-new,
# deliberately empty product master.
# ETL_ALLOW_EMPTY_PRODUCT_MAPPING=false
# Output workbook names inside ETL_OUTPUT_DIR (Excel/both output modes only).
# OUTPUT_FILE=SalesModel_OneOutput.xlsx
# Alternative to DB_HOST/DB_PORT/DB_NAME/DB_USER/DB_PASSWORD: a full SQLAlchemy URL
# (mysql+pymysql://USER:PASSWORD@HOST:3306/DBNAME). Never commit a real one.
# DB_URL=
