# Env file for the containerized ETL Flask API (data/etl/api/, built via data/etl/Dockerfile.api).
# docker-compose.yml loads this via `env_file: ./data/etl/.env` -- Docker injects these as real
# environment variables into the etl-api container, which the Flask process (api_config.py) reads
# directly, and which the pipeline subprocess it spawns (data/etl/src/sales_pipeline/main.py, via
# config/settings.py's Settings.from_env()) inherits in turn. Copy to .env and fill in for local
# `docker compose up`; on the VPS these same values go in the real data/etl/.env deployed there.

# --- MySQL (same production instance the backend/data/ingestion services use) ---
# DB_USER/DB_NAME left blank deliberately (not "ps_warehouse_user"/"ps_warehouse" -- those looked
# like real values but pointed at a user/database that doesn't exist, which is exactly what let
# this go unnoticed: Odoo creds are obviously blank, but a wrong-looking-plausible DB_USER/DB_NAME
# isn't). Copy the real values from backend/.env's DB_USER/DB_NAME -- same MySQL instance, reused
# as-is, per docs/etl-deployment.md.
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# --- Odoo (real pipeline, not mocked -- see data/etl/README.md) ---
ODOO_URL=https://your-instance.odoo.com
ODOO_DB=
ODOO_USER=
ODOO_API_KEY=
ODOO_TIMEOUT_SECONDS=60
ODOO_MAX_RETRIES=5

# --- Business timezone (all Odoo UTC timestamps are converted to this before storage) ---
# config/settings.py defaults to Africa/Tripoli if unset -- set explicitly anyway so this never
# silently depends on the code default again.
TIMEZONE=Africa/Tripoli

# --- Manual input Excel workbooks the pipeline validates against every run ---
INPUT_DIR=./Input
OUTPUT_DIR=./Exports

# --- ETL Flask API (data/etl/api/) ---
# Bearer token backend/.env's ETL_API_KEY must match exactly.
ETL_API_KEY=
# Generate with: openssl rand -base64 32
LOG_LEVEL=INFO
FLASK_ENV=production
# PYTHON_BIN is left unset in Docker -- the image installs the pipeline into its own system
# Python (see Dockerfile.api), so api_config.py's default (sys.executable) is already correct.
PYTHON_BIN=
