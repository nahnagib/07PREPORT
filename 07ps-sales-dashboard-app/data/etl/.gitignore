# Python
__pycache__/
*.pyc
*.pyo
*.pyd

# Virtual env (created locally / on the server per DEPLOYMENT.md, never committed)
venv/
.venv/

# Real credentials. The Flask ETL API (data/etl/api/app.py, containerized via
# data/etl/Dockerfile.api) reads DB_*/ODOO_*/ETL_API_KEY/etc. from its own .env at this root (see
# data/etl/.env.example) -- unlike the old direct-subprocess design (pythonRunner.ts spawning
# Python itself), this is now a separate process/container and needs a real .env of its own.
.env

# Logs (structured run history lives in MySQL: pipeline_run_log/pipeline_run_audit;
# backend/src/etl writes its own orchestration logs to backend/logs/etl/)
logs/

# Runtime input/output data, not code
Input/
Exports/

.pytest_cache/
