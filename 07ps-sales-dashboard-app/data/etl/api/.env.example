# ETL Flask API (app.py/wsgi.py) -- wraps data/etl/src/sales_pipeline/main.py as an HTTP service.
# backend/src/etl/services/pythonRunner.ts calls this instead of spawning Python directly.
#
# This file is for running the API standalone (`cd data/etl/api && python app.py`), outside
# Docker/VPS. For the docker-compose/VPS deployment, use the parent data/etl/.env.example instead
# (it's the one docker-compose.yml's `env_file: ./data/etl/.env` actually loads, and it covers the
# full DB_*/ODOO_*/INPUT_DIR/OUTPUT_DIR list this file's last paragraph just describes).

# Bearer token Node must send as `Authorization: Bearer <key>`. Must match backend/.env's
# ETL_API_KEY exactly (both sides share one secret). Generate with: openssl rand -base64 32
ETL_API_KEY=

LOG_LEVEL=INFO
PORT=5001

# Interpreter the subprocess is spawned with - point this at the same venv main.py already runs
# under (e.g. data/etl/.venv/bin/python). Defaults to whatever interpreter is running this Flask
# app if unset.
PYTHON_BIN=

# DB_*/ODOO_*/INPUT_DIR/OUTPUT_DIR/etc. are NOT read by this Flask process directly - they're read
# by the subprocess it spawns (data/etl/config/settings.py's Settings.from_env()), which inherits
# this process's OS environment. Set the full list data/etl/config/settings.py expects (ODOO_URL,
# ODOO_DB, ODOO_USER, ODOO_API_KEY, INPUT_DIR, OUTPUT_DIR, DB_HOST, DB_PORT, DB_NAME, DB_USER,
# DB_PASSWORD, etc.) here too - this file does not duplicate that list to avoid two sources of
# truth drifting apart (see data/etl/.env.example, which does list them all, for the compose path).
