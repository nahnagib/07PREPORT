# PRODUCTION -- backend + etl-worker (backend/.env). Placeholders only; real values live on the host
# (or in your secret manager) and are never committed.
PORT=4000
NODE_ENV=production
APP_TIMEZONE=Africa/Tripoli
REFRESH_CHECK_TOLERANCE_MINUTES=5
REFRESH_STALE_AFTER_MINUTES=270

# MySQL 8 -- the application user (see docs/DEPLOYMENT.md section 4 for its exact grants).
# DB_HOST is overridden by docker-compose.yml (DB_HOST_FOR_CONTAINERS); DB_SOCKET stays empty in Docker.
DB_HOST=CHANGE_ME
DB_PORT=3306
DB_USER=ps_app
DB_PASSWORD=CHANGE_ME
DB_NAME=ps_warehouse
DB_SOCKET=

# Generate with: openssl rand -base64 48 -- different per environment, never reused.
JWT_SECRET=CHANGE_ME_LONG_RANDOM
# Browser origin(s) of the frontend (comma-separated); CORS allow-list and password-reset link base.
FRONTEND_ORIGIN=https://dashboard.example.com

SMTP_HOST=CHANGE_ME
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=CHANGE_ME
SMTP_PASSWORD=CHANGE_ME
SMTP_FROM="BMH Sales Dashboard <no-reply@dashboard.example.com>"
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_LOGIN_WINDOW_MIN=15
ACCOUNT_LOCK_THRESHOLD=5
PASSWORD_RESET_TOKEN_TTL_MIN=60

# ETL orchestration. ETL_API_URL / REDIS_HOST / ETL_LOG_DIR are set by docker-compose.yml.
ETL_API_URL=http://etl-api:5001
# Must equal data/etl's ETL_API_KEY. Generate with: openssl rand -base64 32
ETL_API_KEY=CHANGE_ME
ETL_API_POLL_INTERVAL_MS=1000
# Server-only switches (default false). THIS IS THE SERVER: both true. Nowhere else.
ETL_SCHEDULER_ENABLED=true
ETL_WORKER_ENABLED=true
# Never set ETL_SCHEDULER_OFF_OK here: with a switch off, the server must log an error and show the red banner.
# 30-minute refresh (job refresh_30m): shared lists -> receivables + collections -> NPS, each module isolated. The
# modules are ETL_REFRESH_MODULES in data/etl/.env. Interval = a divisor of 60 (default 30), or an explicit cron in
# ETL_SCHEDULE_REFRESH_CRON. A tick in the same minute as the full or sales run yields to it.
ETL_SCHEDULE_REFRESH_ENABLED=true
ETL_REFRESH_INTERVAL_MINUTES=30
# Sales (job main = core dims -> sales): keeps its own slots until its write_date incremental is built (Phase B).
ETL_SCHEDULE_INCREMENTAL_CRON=50 8,11,14,17,20 * * *
ETL_SCHEDULE_INCREMENTAL_ENABLED=true
# Full refresh (full_all = core dims -> receivables -> sales full rebuild), unchanged.
ETL_SCHEDULE_FULL_CRON=0 2 * * *
ETL_SCHEDULE_FULL_ENABLED=true
# The old 15:00 receivables run (finance_receivables alone): off, the 30-minute refresh covers it. Rollback = true.
ETL_SCHEDULE_FINANCE_CRON=0 15 * * *
ETL_SCHEDULE_FINANCE_ENABLED=false
# The NPS Score's own nightly schedule (full reload). While the full schedule above is on, NPS is the last step of that
# 02:00 full_all and this own schedule is NOT registered (never twice a night). Only with ETL_SCHEDULE_FULL_ENABLED=false
# does process_nps run alone at this cron. The 30-minute refresh also runs process_nps (ETL's ETL_REFRESH_MODULES).
# Set true together with the ETL's NPS_ENABLED.
ETL_SCHEDULE_PROCESS_NPS_CRON=0 2 * * *
ETL_SCHEDULE_PROCESS_NPS_ENABLED=false
# Phase B: the sales build from the Odoo mirror, on the second queue (etl-long), 10 minutes after each refresh tick.
# true with ETL_SALES_MODE=shadow / incremental (etl.env); in legacy mode the job ends at once.
ETL_SCHEDULE_SALES_BUILD_CRON=10,40 * * * *
ETL_SCHEDULE_SALES_BUILD_ENABLED=true
ETL_SCHEDULE_TIMEZONE=Africa/Tripoli
REDIS_HOST=redis
REDIS_PORT=6379
