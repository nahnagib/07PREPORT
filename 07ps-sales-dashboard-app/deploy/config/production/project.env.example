# PRODUCTION -- docker compose project variables. Copy to the repo root as `.env` on the production host.
# Placeholders only: never commit a filled-in copy. Variable reference: docs/DEPLOYMENT.md section 2.
APP_TIMEZONE=Africa/Tripoli
# Set by the deploy script (scripts/deploy.sh) to the release being deployed, e.g. v1.4.0 or a git SHA.
IMAGE_TAG=CHANGE_ME_RELEASE_TAG
DB_HOST_FOR_CONTAINERS=CHANGE_ME_DB_HOSTNAME_OR_host.docker.internal
ETL_INPUT_HOST_DIR=/srv/07ps/etl/input
# ETL_OUTPUT_HOST_DIR=/srv/07ps/etl/output   # unset = named volume etl_output
NEXT_PUBLIC_API_BASE_URL=https://api.example.com
