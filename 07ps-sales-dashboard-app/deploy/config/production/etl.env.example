# PRODUCTION -- etl-api (data/etl/.env). Placeholders only.
# DB user: the ETL-specific account (read+write on the target schema only, docs/DEPLOYMENT.md section 4).
# DB_HOST, TIMEZONE, DB_SESSION_TIMEZONE, ETL_INPUT_DIR and ETL_OUTPUT_DIR are set by docker-compose.yml.
DB_HOST=CHANGE_ME
DB_PORT=3306
DB_USER=ps_etl
DB_PASSWORD=CHANGE_ME
DB_NAME=ps_warehouse

ODOO_URL=https://CHANGE_ME.odoo.com
ODOO_DB=CHANGE_ME
ODOO_USER=CHANGE_ME
ODOO_API_KEY=CHANGE_ME
ODOO_TIMEOUT_SECONDS=60
ODOO_MAX_RETRIES=5
# ETL platform production guard (data/etl/.env.example explains each).
ODOO_PROD_DB=CHANGE_ME
ODOO_ALLOWED_HOSTS=CHANGE_ME.odoo.com
ODOO_COMPANY_IDS=1,3
# Optional: extra in-scope companies by Odoo name. Names are resolved to ids at runtime.
ODOO_COMPANY_NAMES=Athena
ODOO_KEY_EXPIRES=
# Dedicated read-only bot user for finance_receivables (docs/receivables-etl.md). Leave these three commented out
# until the bot exists: the job then uses the default ETL credentials above and logs a WARNING on each run.
# ODOO_DEBT_LOGIN=CHANGE_ME
# ODOO_DEBT_API_KEY=CHANGE_ME
# ODOO_DEBT_KEY_EXPIRES=YYYY-MM-DD

# Finance: Odoo partner ids whose receivables are inter-company balances although they are not our own companies'
# partners (decision A1, 2026-10-04): 15907 "مديونية شركة تيكا" (on Majaal's books), 15905 "مديونية مجال" (on Tika's).
# They are flagged is_intercompany and left out of the Debt page's default view. Empty = only the companies' own partners.
FINANCE_INTERCOMPANY_PARTNER_IDS=15905,15907

TIMEZONE=Africa/Tripoli
DB_SESSION_TIMEZONE=+00:00

# Must equal backend ETL_API_KEY.
ETL_API_KEY=CHANGE_ME
LOG_LEVEL=INFO
FLASK_ENV=production
PYTHON_BIN=
