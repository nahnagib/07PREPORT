# STAGING -- backend + etl-worker (backend/.env). Placeholders only; real values live on the host
# (or in your secret manager) and are never committed.
PORT=4000
NODE_ENV=production
APP_TIMEZONE=Africa/Tripoli
REFRESH_CHECK_TOLERANCE_MINUTES=5
REFRESH_STALE_AFTER_MINUTES=270

# MySQL 8 -- the application user (see docs/DEPLOYMENT.md section 4 for its exact grants).
# DB_HOST is overridden by docker-compose.yml (DB_HOST_FOR_CONTAINERS); DB_SOCKET stays empty in Docker.
DB_HOST=CHANGE_ME
DB_PORT=3306
DB_USER=ps_app
DB_PASSWORD=CHANGE_ME
DB_NAME=ps_warehouse_staging
DB_SOCKET=

# Generate with: openssl rand -base64 48 -- different per environment, never reused.
JWT_SECRET=CHANGE_ME_LONG_RANDOM
# Browser origin(s) of the frontend (comma-separated); CORS allow-list and password-reset link base.
FRONTEND_ORIGIN=https://staging.example.com

SMTP_HOST=CHANGE_ME
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=CHANGE_ME
SMTP_PASSWORD=CHANGE_ME
SMTP_FROM="BMH Sales Dashboard <no-reply@staging.example.com>"
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_LOGIN_WINDOW_MIN=15
ACCOUNT_LOCK_THRESHOLD=5
PASSWORD_RESET_TOKEN_TTL_MIN=60

# ETL orchestration. ETL_API_URL / REDIS_HOST / ETL_LOG_DIR are set by docker-compose.yml.
ETL_API_URL=http://etl-api:5001
# Must equal data/etl's ETL_API_KEY. Generate with: openssl rand -base64 32
ETL_API_KEY=CHANGE_ME
ETL_API_POLL_INTERVAL_MS=1000
ETL_SCHEDULE_INCREMENTAL_CRON=50 8,11,14,17,20 * * *
ETL_SCHEDULE_INCREMENTAL_ENABLED=false
ETL_SCHEDULE_FULL_CRON=0 2 * * *
ETL_SCHEDULE_FULL_ENABLED=false
ETL_SCHEDULE_TIMEZONE=Africa/Tripoli
REDIS_HOST=redis
REDIS_PORT=6379
