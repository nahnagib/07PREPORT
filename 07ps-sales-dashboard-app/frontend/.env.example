# Frontend configuration - copy to .env.local for local dev (Next.js loads .env.local
# automatically; it's gitignored, unlike this .example file).

# Base URL frontend/src/lib/api.ts calls the backend at. Defaults to http://localhost:4000 if
# unset, which is correct for local dev (backend/src/server.ts also defaults to PORT=4000).
#
# In production this is a separate origin/subdomain, not a relative path -- backend routes are
# mounted at root paths (/health, /tachometer, /admin/etl-runs, etc.), not under an /api/ prefix,
# and some of those paths collide with frontend page routes (e.g. /admin/etl-runs is both a
# Next.js page and a backend API route) -- so the two must be different origins, not path-routed
# on one domain. See docker-compose.yml's frontend.build.args and docs/vps-deployment.md.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
