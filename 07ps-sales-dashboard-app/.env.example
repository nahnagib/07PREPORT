# Docker Compose project variables (read by `docker compose` from this file's sibling `.env`).
# Copy to `.env` and adjust. Not the same as backend/.env, data/etl/.env or frontend/.env.local.
# Per-environment starting points: deploy/config/staging/ and deploy/config/production/.

# --- Timezone -----------------------------------------------------------------------------------
# ONE zone for the whole stack (IANA id). Becomes TZ on every container, the backend's APP_TIMEZONE, the
# ETL's TIMEZONE, the cron schedule zone and the frontend's NEXT_PUBLIC_APP_TIMEZONE (build arg).
APP_TIMEZONE=Africa/Tripoli

# --- Images -------------------------------------------------------------------------------------
# Tag applied to (and pulled for) the 07ps/* images. CI sets it to the release version or git SHA.
IMAGE_TAG=local

# --- Database host as seen FROM the containers ----------------------------------------------------
# host.docker.internal = a MySQL running on the Docker host itself. For a separate DB server, put its
# hostname/IP here. (DB name/user/password live in backend/.env and data/etl/.env, never here.)
DB_HOST_FOR_CONTAINERS=host.docker.internal

# --- ETL files ----------------------------------------------------------------------------------
# Host folder holding the ETL's manual input workbooks: sales_targets.xlsx, SalesTeam.xlsx,
# OffDays.xlsx, PRODUCTS.xlsx and BlockedCustomers.xlsx. Mounted READ-ONLY into the etl-api container
# at /etl/input (ETL_INPUT_DIR is set to that for you in docker-compose.yml). Host's own notation:
#   Docker Desktop on Windows:  ETL_INPUT_HOST_DIR=C:/Users/you/Desktop/Input
#   Linux server:               ETL_INPUT_HOST_DIR=/srv/etl/input
# Default if unset: ./data/etl/input
ETL_INPUT_HOST_DIR=./data/etl/input

# Where the ETL writes generated files (Excel outputs, caches). Unset = the named volume `etl_output`.
# Set a host folder to bind-mount instead (must be writable by the container's user).
# ETL_OUTPUT_HOST_DIR=/srv/etl/output

# --- Frontend build-time ------------------------------------------------------------------------
# Inlined into the browser bundle at build time: changing it needs `docker compose build frontend`.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
